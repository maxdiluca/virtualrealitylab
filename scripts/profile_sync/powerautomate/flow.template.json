                  }
                },
                "runAfter": {}
              }
            }
          },
          "runAfter": {
            "Avatar_stem": [
              "Succeeded"
            ]
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs",
                "outputs"
              ]
            }
          }
        },
        "Require_configuration": {
          "type": "If",
          "expression": "@and(startsWith(parameters('ProfileSiteAddress'),'https://'),not(contains(parameters('ProfileSiteAddress'),'__')),startsWith(parameters('ProfileRoot'),'/'),not(endsWith(parameters('ProfileRoot'),'/')),not(contains(parameters('ProfileRoot'),'..')),not(contains(parameters('ProfileRoot'),'__')),not(contains(parameters('ProfileRoot'),'%')),not(contains(parameters('ProfileRoot'),'?')),not(contains(parameters('ProfileRoot'),'#')),greater(length(parameters('ProfileApprover')),0),equals(length(split(parameters('ProfileApprover'),'@')),2),not(contains(parameters('ProfileApprover'),'__')),not(contains(parameters('ProfileApprover'),';')),not(contains(parameters('ProfileApprover'),',')),not(contains(parameters('ProfileApprover'),' ')),not(contains(parameters('ProfileApprover'),decodeUriComponent('%0A'))),not(contains(parameters('ProfileApprover'),decodeUriComponent('%0D'))),equals(parameters('GitHubOwner'),'maxdiluca'),equals(parameters('GitHubRepository'),'virtualrealitylab'))",
          "actions": {
            "Require_configuration_passed": {
