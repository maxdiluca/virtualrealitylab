y()?['ImageConsentVerified'],true),equals(triggerBody()?['DispatchIntentReserved'],true))",
          "actions": {
            "Require_input_boundaries_passed": {
              "type": "Compose",
              "inputs": "validated",
              "runAfter": {}
            }
          },
          "else": {
            "actions": {
              "Require_input_boundaries_stopped": {
                "type": "Terminate",
                "inputs": {
                  "runStatus": "Failed",
                  "runError": {
                    "code": "PROFILE_INPUT_OR_READINESS_INVALID",
