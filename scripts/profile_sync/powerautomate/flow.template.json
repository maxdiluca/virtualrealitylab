              "else": {
                "actions": {
                  "Require_one_response_stopped": {
                    "type": "Terminate",
                    "inputs": {
                      "runStatus": "Failed",
                      "runError": {
                        "code": "PROFILE_APPROVAL_RESPONSE_INVALID",
                        "message": "Profile sync stopped. Inspect the private run and reconcile the private submission ledger before any retry."
                      }
