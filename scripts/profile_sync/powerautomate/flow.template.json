                  "maxLength": 80
                },
                "AvatarFilename": {
                  "type": "string",
                  "title": "AvatarFilename",
                  "default": "DEFAULT_AVATAR.png"
                },
                "SubmissionKey": {
                  "type": "string",
                  "title": "SubmissionKey from the private durable ledger",
                  "minLength": 1,
                  "maxLength": 100
                },
                "SubjectConsentVerified": {
                  "type": "boolean",
                  "title": "Separate recorded subject consent verified",
                  "default": false
                },
                "ImageConsentVerified": {
                  "type": "boolean",
                  "title": "Separate recorded image consent verified",
                  "default": false
                },
                "DispatchIntentReserved": {
                  "type": "boolean",
                  "title": "Private dispatch intent reserved for this key and exact file versions; uncertain prior writes reconciled",
                  "default": false
                }
              },
              "required": [
                "FolderKey",
                "SubmissionKey",
                "SubjectConsentVerified",
                "ImageConsentVerified",
                "DispatchIntentReserved"
              ],
              "additionalProperties": false
            }
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs",
                "outputs"
              ]
            },
            "concurrency": {
              "runs": 1,
              "maximumWaitingRuns": 10
            }
          }
        }
      },
      "actions": {
        "Cloud_actions_enabled": {
          "type": "If",
          "expression": "@equals(parameters('EnableCloudActions'),true)",
          "runAfter": {},
          "actions": {
            "Cloud_gate_passed": {
              "type": "Compose",
              "inputs": "cloud-gate-passed",
              "runAfter": {}
            }
          },
          "else": {
            "actions": {
              "Disabled": {
                "type": "Compose",
                "inputs": {
                  "status": "disabled-no-cloud-actions",
                  "publication_verified": false
                },
                "runAfter": {}
              },
              "Stop_disabled": {
                "type": "Terminate",
                "inputs": {
                  "runStatus": "Succeeded"
                },
                "runAfter": {
                  "Disabled": [
                    "Succeeded"
                  ]
                }
              }
            }
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs",
                "outputs"
              ]
            }
          }
        },
        "Folder_key": {
          "type": "Compose",
          "inputs": "@string(coalesce(triggerBody()?['FolderKey'],''))",
          "runAfter": {
            "Cloud_actions_enabled": [
              "Succeeded"
            ]
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs",
                "outputs"
              ]
            }
          }
        },
        "Submission_key": {
          "type": "Compose",
          "inputs": "@string(coalesce(triggerBody()?['SubmissionKey'],''))",
          "runAfter": {
            "Folder_key": [
              "Succeeded"
            ]
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs",
                "outputs"
              ]
            }
          }
        },
        "Avatar_filename": {
          "type": "Compose",
          "inputs": "@if(empty(triggerBody()?['AvatarFilename']),'DEFAULT_AVATAR.png',string(triggerBody()?['AvatarFilename']))",
          "runAfter": {
            "Submission_key": [
              "Succeeded"
            ]
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs",
                "outputs"
              ]
            }
          }
