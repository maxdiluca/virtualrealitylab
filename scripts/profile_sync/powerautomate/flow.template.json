              "runAfter": {
                "Markdown_snapshot_text": [
                  "Succeeded"
                ]
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              }
            },
            "Approval": {
              "type": "OpenApiConnectionWebhook",
              "inputs": {
                "host": {
                  "connectionName": "shared_approvals",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_approvals",
                  "operationId": "StartAndWaitForAnApproval"
                },
                "parameters": {
                  "approvalType": "Basic",
                  "WebhookApprovalCreationInput/title": "VR Lab website: review the exact attached profile",
                  "WebhookApprovalCreationInput/assignedTo": "@parameters('ProfileApprover')",
                  "WebhookApprovalCreationInput/details": "Review both exact attachments in full. The receiver will preserve their bytes and place index.md at content/authors/FolderKey/_index.md and the image at content/authors/FolderKey/avatar.png or avatar.jpg (according to its extension); it will not rewrite or re-encode their contents. Approve only after you have verified separate recorded consent from the person for the exact final website preview and public image use; complete biography, valid role and public links; no private induction/access material or image metadata; and an immutable private ledger reservation for the submitted folder, exact file versions and SubmissionKey. This approves a proposed GitHub profile addition. Publication still requires PR review and merge. Reject anything incomplete or changed.",
                  "WebhookApprovalCreationInput/enableNotifications": true,
                  "WebhookApprovalCreationInput/enableReassignment": false,
                  "WebhookApprovalCreationInput/attachments": [
