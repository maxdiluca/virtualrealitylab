              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              }
            },
            "Reread_markdown": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "GetFileContentByPath"
                },
                "parameters": {
                  "dataset": "@parameters('ProfileSiteAddress')",
                  "path": "@concat(parameters('ProfileRoot'),'/',outputs('Folder_key'),'/index.md')",
                  "inferContentType": true
                },
                "retryPolicy": {
                  "type": "exponential",
                  "count": 3,
                  "interval": "PT5S",
                  "minimumInterval": "PT5S",
                  "maximumInterval": "PT30S"
                }
              },
              "runAfter": {
                "Require_exact_approval": [
                  "Succeeded"
                ]
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              }
            },
            "Reread_avatar": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "GetFileContentByPath"
                },
                "parameters": {
                  "dataset": "@parameters('ProfileSiteAddress')",
                  "path": "@concat(parameters('ProfileRoot'),'/',outputs('Folder_key'),'/',outputs('Avatar_filename'))",
                  "inferContentType": true
                },
                "retryPolicy": {
                  "type": "exponential",
                  "count": 3,
                  "interval": "PT5S",
                  "minimumInterval": "PT5S",
                  "maximumInterval": "PT30S"
                }
              },
              "runAfter": {
                "Reread_markdown": [
                  "Succeeded"
                ]
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              }
            },
            "Require_unchanged_snapshots": {
              "type": "If",
              "expression": "@and(equals(string(coalesce(body('Reread_markdown')?['$content'],'')),outputs('Markdown_snapshot_base64')),equals(string(coalesce(body('Reread_avatar')?['$content'],'')),outputs('Avatar_snapshot_base64')))",
              "actions": {
                "Require_unchanged_snapshots_passed": {
                  "type": "Compose",
                  "inputs": "validated",
                  "runAfter": {}
