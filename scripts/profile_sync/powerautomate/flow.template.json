                    "parameters": {
                      "repositoryOwner": "@parameters('GitHubOwner')",
                      "repositoryName": "@parameters('GitHubRepository')",
                      "event_type": "vr-lab-profile-approved-v1",
                      "client_payload": "@outputs('Client_payload')"
                    },
                    "retryPolicy": {
                      "type": "none"
                    }
                  },
                  "runAfter": {},
                  "runtimeConfiguration": {
                    "secureData": {
                      "properties": [
                        "inputs",
                        "outputs"
                      ]
                    }
                  }
                },
                "Queued_unverified": {
                  "type": "Compose",
                  "inputs": {
                    "status": "queued-unverified",
                    "publication_verified": false
                  },
                  "runAfter": {
                    "Dispatch_approved_profile": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {
                  "Dispatch_disabled": {
                    "type": "Compose",
                    "inputs": {
                      "status": "staged-dispatch-disabled",
                      "publication_verified": false
                    },
                    "runAfter": {}
                  }
                }
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              }
            }
          },
          "runAfter": {
            "Require_configuration": [
              "Succeeded"
            ]
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs",
                "outputs"
              ]
            }
          }
        },
        "Catch_failure": {
          "type": "Scope",
          "runAfter": {
            "Profile_sync": [
              "Failed",
              "TimedOut"
            ]
          },
          "actions": {
            "Optional_failure_notification": {
              "type": "If",
              "expression": "@and(equals(parameters('EnableCloudActions'),true),equals(parameters('EnableFailureNotifications'),true))",
              "runAfter": {},
              "actions": {
                "Notify_same_named_operator": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_office365",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                      "operationId": "SendEmailV2"
                    },
                    "parameters": {
                      "emailMessage/To": "@parameters('ProfileApprover')",
                      "emailMessage/Subject": "VR Lab website profile sync: private operator review required",
                      "emailMessage/Body": "<p>PROFILE_SYNC_FAILED_OR_TIMED_OUT</p><p>Inspect the private run and reconcile the private submission ledger before any retry. A dispatch failure or timeout may still have queued work. No publication has been verified.</p>",
                      "emailMessage/Importance": "Normal"
                    },
                    "retryPolicy": {
                      "type": "none"
                    }
                  },
                  "runAfter": {},
                  "runtimeConfiguration": {
                    "secureData": {
                      "properties": [
                        "inputs",
                        "outputs"
                      ]
                    }
                  }
                }
              },
              "else": {
                "actions": {
                  "Notification_disabled": {
                    "type": "Compose",
                    "inputs": "failure-notification-disabled",
                    "runAfter": {}
                  }
                }
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              }
            },
            "Stop_after_failure": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "PROFILE_SYNC_FAILED_OR_TIMED_OUT",
                  "message": "Profile sync stopped. Inspect the private run and reconcile the private submission ledger before any retry."
                }
              },
              "runAfter": {
                "Optional_failure_notification": [
                  "Succeeded",
                  "Failed",
                  "TimedOut",
                  "Skipped"
                ]
              }
            }
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs",
                "outputs"
              ]
            }
          }
        }
      },
      "outputs": {}
    },
