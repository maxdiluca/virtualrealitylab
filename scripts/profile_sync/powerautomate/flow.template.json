              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              }
            },
            "Require_snapshot_bounds": {
              "type": "If",
              "expression": "@and(equals(base64(outputs('Markdown_snapshot_text')),outputs('Markdown_snapshot_base64')),greater(length(trim(outputs('Markdown_snapshot_text'))),0),lessOrEquals(length(outputs('Markdown_snapshot_text')),12000),lessOrEquals(length(outputs('Markdown_snapshot_base64')),21332),greater(length(outputs('Avatar_snapshot_base64')),0),lessOrEquals(length(outputs('Avatar_snapshot_base64')),43688))",
              "actions": {
                "Require_snapshot_bounds_passed": {
                  "type": "Compose",
                  "inputs": "validated",
                  "runAfter": {}
                }
              },
              "else": {
